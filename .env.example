# preflight402 configuration — copy to .env and edit.
# Every variable is optional; the defaults shown here are the built-in ones,
# so an empty .env (or none at all) boots the app identically.

# dev | prod. Paid routes stay unpaywalled in dev (wired up at M4).
PREFLIGHT402_ENVIRONMENT=dev

# SQLite database file (WAL mode). Relative paths resolve against the CWD.
PREFLIGHT402_DB_PATH=preflight402.db

# RPC provider keys. Leave unset for the free tier — nothing before M5
# (reputation reads) or M7 (Solana) uses them.
# PREFLIGHT402_ALCHEMY_API_KEY=
# PREFLIGHT402_HELIUS_API_KEY=

# ERC-8004 reputation (M5). The Graph gateway API key for the Agent0 subgraphs
# (thegraph.com/studio/apikeys). Unset = binding/reputation OFF: the
# reputation block stays null and no subgraph call is made.
# PREFLIGHT402_GRAPH_API_KEY=
PREFLIGHT402_GRAPH_TIMEOUT_S=8

# Sybil filter (M6). Runs only when ALCHEMY_API_KEY (above) is set; without
# it sybil_status stays "not_checked" and no RPC call is made.
PREFLIGHT402_ALCHEMY_TIMEOUT_S=5
# Uncached first-funder lookups allowed per preflight pass (0 = unlimited).
# Funding facts cache permanently, so big agents converge across passes.
PREFLIGHT402_SYBIL_MAX_LOOKUPS_PER_PASS=40
# Parallel in-flight Alchemy calls (free tier: 25 rps / 500 CUPS).
PREFLIGHT402_SYBIL_CONCURRENCY=8
# Wall-clock ceiling for one pass's RPC phase, seconds (<= 0 disables).
PREFLIGHT402_SYBIL_PASS_TIMEOUT_S=12
# Daily ceiling on service-path funding lookups (0 = uncapped) so a caller
# forcing cache misses cannot drain the Alchemy CU budget. CLI backfills
# (explicit --batch) bypass it.
PREFLIGHT402_SYBIL_DAILY_LOOKUP_CAP=5000
# Funder-ancestry generations explored when clustering (>= 1): clusters form
# by shared funding ROOT so one-hop intermediaries can't defeat the filter.
PREFLIGHT402_SYBIL_ANCESTRY_DEPTH=3
# OPT-IN fan-out hub heuristic: a funder whose funded reviewers span this
# many DISTINCT agents never clusters them. 0 (default) disables it — the
# signal derives from attacker-writable feedback and can be gamed to
# whitewash a farm funder. Labeled hubs are always excluded regardless.
PREFLIGHT402_SYBIL_HUB_MIN_AGENTS=0

# Probing.
# SSRF guard: false (default) refuses to probe private/loopback/metadata
# targets so a public /preflight can't scan the host's own network. Set true
# only for local dev against private x402 endpoints.
PREFLIGHT402_ALLOW_PRIVATE_TARGETS=false
PREFLIGHT402_PROBE_TIMEOUT_S=10
PREFLIGHT402_PROBE_CONCURRENCY=20
# A GET answered with one of these statuses is retried once as an empty JSON
# POST: most x402 endpoints are POST endpoints, and a GET-only probe mislabels
# them dead (~55% of "zombie" endpoints serve a valid 402 on POST — see
# docs/checkpoint-m3.md). JSON list. [] disables the retry; [405] restores the
# old pre-fix behaviour. 5xx/3xx are deliberately never retried.
PREFLIGHT402_PROBE_POST_RETRY_STATUSES=[200,400,401,403,404,405,415,422]
# The set used for URLs NO registry advertised — i.e. arbitrary URLs handed to
# the free public /preflight. Narrow BY DESIGN: a 405 is the server itself
# saying the method was wrong. Widening this turns the public endpoint into a
# relay that POSTs at any victim a caller names.
PREFLIGHT402_PROBE_POST_RETRY_STATUSES_UNLISTED=[405]
PREFLIGHT402_PER_HOST_MIN_INTERVAL_S=60
PREFLIGHT402_SCHEDULER_CYCLE_S=900

# Continuous probing (M3). Deploy-safe OFF: the in-app scheduler only runs
# when explicitly enabled — a redeploy must never silently start bulk
# probing from a home IP. The CLI (python -m preflight402.scheduler) always
# runs when invoked, regardless of this flag.
PREFLIGHT402_SCHEDULER_ENABLED=false
# Endpoints probed per cycle; 0 = unlimited. Set small (e.g. 50) for
# conservative testing from a home connection.
PREFLIGHT402_SCHEDULER_MAX_PER_CYCLE=0

# Free-preflight verdict cache TTL (seconds).
PREFLIGHT402_PREFLIGHT_CACHE_TTL_S=300

# Per-client-IP rate limit on /preflight, requests per minute (0 disables).
PREFLIGHT402_RATE_LIMIT_PER_MINUTE=60
