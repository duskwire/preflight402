# preflight402 configuration — copy to .env and edit.
# Every variable is optional; the defaults shown here are the built-in ones,
# so an empty .env (or none at all) boots the app identically.

# dev | prod. Paid routes stay unpaywalled in dev (wired up at M4).
PREFLIGHT402_ENVIRONMENT=dev

# SQLite database file (WAL mode). Relative paths resolve against the CWD.
PREFLIGHT402_DB_PATH=preflight402.db

# RPC provider keys. Leave unset for the free tier — nothing before M5
# (reputation reads) or M7 (Solana) uses them.
# PREFLIGHT402_ALCHEMY_API_KEY=
# PREFLIGHT402_HELIUS_API_KEY=

# ERC-8004 reputation (M5). The Graph gateway API key for the Agent0 subgraphs
# (thegraph.com/studio/apikeys). Unset = binding/reputation OFF: the
# reputation block stays null and no subgraph call is made.
# PREFLIGHT402_GRAPH_API_KEY=
PREFLIGHT402_GRAPH_TIMEOUT_S=8

# Probing.
# SSRF guard: false (default) refuses to probe private/loopback/metadata
# targets so a public /preflight can't scan the host's own network. Set true
# only for local dev against private x402 endpoints.
PREFLIGHT402_ALLOW_PRIVATE_TARGETS=false
PREFLIGHT402_PROBE_TIMEOUT_S=10
PREFLIGHT402_PROBE_CONCURRENCY=20
PREFLIGHT402_PER_HOST_MIN_INTERVAL_S=60
PREFLIGHT402_SCHEDULER_CYCLE_S=900

# Continuous probing (M3). Deploy-safe OFF: the in-app scheduler only runs
# when explicitly enabled — a redeploy must never silently start bulk
# probing from a home IP. The CLI (python -m preflight402.scheduler) always
# runs when invoked, regardless of this flag.
PREFLIGHT402_SCHEDULER_ENABLED=false
# Endpoints probed per cycle; 0 = unlimited. Set small (e.g. 50) for
# conservative testing from a home connection.
PREFLIGHT402_SCHEDULER_MAX_PER_CYCLE=0

# Free-preflight verdict cache TTL (seconds).
PREFLIGHT402_PREFLIGHT_CACHE_TTL_S=300

# Per-client-IP rate limit on /preflight, requests per minute (0 disables).
PREFLIGHT402_RATE_LIMIT_PER_MINUTE=60
